# #############################################################
# Important pour tous les membres du projet :
# Installez l'extension EditorConfig pour votre éditeur (VS Code, WebStorm, Sublime, etc.).
# Cela garantit l'application automatique de ces règles de formatage.
# Plus d'infos : https://EditorConfig.org
# #############################################################
# EditorConfig is awesome: https://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
